# Opt-in read-only package-energy telemetry for Omarchy administrator users.
# MODE/GROUP only apply to device nodes, so sysfs permissions use bounded RUN commands.
ACTION=="add", SUBSYSTEM=="powercap", KERNEL=="intel-rapl:[0-9]", RUN+="/usr/bin/chgrp wheel /sys%p/energy_uj", RUN+="/usr/bin/chmod 0440 /sys%p/energy_uj"
